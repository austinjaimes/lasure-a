<header class="navbar">
  <div class="navbar-container">
    <a href="#" aria-label="Ir al inicio">
  <img style="width: 300px;" src="/logosurenachico.jpeg" alt="La Sureña">
</a>

    <button class="menu-btn" aria-label="Abrir menú">
      ☰
    </button>

    <nav class="nav">
      <ul class="nav-links">
        <li><a href="#historia">Nuestra historia</a></li>
        <li><a href="#productos">Productos</a></li>
        <li><a href="#contacto">Contacto</a></li>
      </ul>
    </nav>
  </div>

  <script>
  const menuBtn = document.querySelector('.menu-btn');
  const nav = document.querySelector('.nav');
  const navLinks = document.querySelectorAll('.nav-links a');

  menuBtn.addEventListener('click', () => {
    nav.classList.toggle('open');
  });

  // Cerrar menú al hacer clic en un link (mobile)
  navLinks.forEach(link => {
    link.addEventListener('click', () => {
      nav.classList.remove('open');
    });
  });
</script>


  <style>
    /* ===== NAVBAR BASE ===== */
    .navbar {
      position: sticky;
      top: 0;
      z-index: 100;
      background-color: #ee7d39;
      color: white;
    }

    .navbar-container {
      max-width: 1200px;
      margin: auto;
      padding: 1rem 1.5rem 0.5rem 1.5rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .logo {
      font-size: 1.8rem;
      font-weight: 900;
      letter-spacing: 1px;
    }

    /* ===== LINKS DESKTOP ===== */
    .nav-links {
      list-style: none;
      display: flex;
      gap: 1.5rem;
      font-size: 20px;
    }

    .nav-links a {
      color: white;
      text-decoration: none;
      font-weight: 600;
      position: relative;
    }

    .nav-links a::after {
      content: "";
      position: absolute;
      left: 0;
      bottom: -4px;
      width: 0;
      height: 2px;
      background-color: var(--beige);
      transition: width 0.3s ease;
    }

    .nav-links a:hover::after {
      width: 100%;
    }

    /* ===== BOTÓN HAMBURGUESA ===== */
    .menu-btn {
      display: none;
      font-size: 2rem;
      background: none;
      border: none;
      color: white;
      cursor: pointer;
    }

    /* ===== RESPONSIVE ===== */
    @media (max-width: 768px) {
      .menu-btn {
        display: block;
      }

      .nav {
        position: absolute;
        top: 100%;
        left: 0;
        width: 100%;
        background-color: #ee7d39;
        max-height: 0;
        overflow: hidden;
        transition: max-height 0.3s ease;
      }

      .nav.open {
        max-height: 300px;
      }

      .nav-links {
        flex-direction: column;
        padding: 1rem;
        gap: 1rem;
      }
    }
  </style>
</header>
